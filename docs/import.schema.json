{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "import_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "items": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "result",
              "supporting"
            ]
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 100000
          },
          "collections": {
            "default": [],
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "derived_from": {
            "default": [],
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "occurred_at": {
            "type": "string"
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "key",
          "path",
          "description",
          "collections",
          "derived_from",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "members": {
            "minItems": 2,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primary": {
            "type": "string"
          },
          "collections": {
            "default": [],
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "key",
          "title",
          "members",
          "collections"
        ],
        "additionalProperties": false
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string"
        },
        "command": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "import_key",
    "items",
    "groups"
  ],
  "additionalProperties": false
}
